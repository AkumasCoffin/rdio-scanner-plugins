{
  "id": "system-messages",
  "name": "System Messages",
  "version": "1.0.1",
  "apiVersion": 1,
  "description": "Shows system and maintenance messages to listeners above the scanner display, with an HTTP API for posting them from other programs.",
  "author": "Rdio Scanner",
  "license": "GPL-3.0",
  "homepage": "https://github.com/AkumasCoffin/rdio-scanner-plugins/tree/main/plugins/system-messages",
  "minServerVersion": "6.14.4-beta.1",
  "main": "main.js",
  "web": "web/plugin.js",
  "tables": [
    {
      "name": "messages",
      "columns": [
        { "name": "id", "type": "int", "primaryKey": true, "autoIncrement": true },
        { "name": "uid", "type": "varchar", "length": 36, "nullable": false, "index": true },
        { "name": "kind", "type": "varchar", "length": 16, "nullable": false },
        { "name": "color", "type": "varchar", "length": 16, "nullable": false },
        { "name": "title", "type": "varchar", "length": 80, "nullable": false },
        { "name": "body", "type": "text" },
        { "name": "linkUrl", "type": "varchar", "length": 500 },
        { "name": "linkLabel", "type": "varchar", "length": 60 },
        { "name": "startsAt", "type": "bigint" },
        { "name": "endsAt", "type": "bigint" },
        { "name": "revision", "type": "int", "nullable": false, "default": 1 },
        { "name": "source", "type": "varchar", "length": 60, "nullable": false },
        { "name": "createdAt", "type": "bigint", "nullable": false },
        { "name": "updatedAt", "type": "bigint", "nullable": false }
      ]
    },
    {
      "name": "keys",
      "columns": [
        { "name": "id", "type": "int", "primaryKey": true, "autoIncrement": true },
        { "name": "label", "type": "varchar", "length": 60, "nullable": false },
        { "name": "hash", "type": "varchar", "length": 64, "nullable": false, "index": true },
        { "name": "createdAt", "type": "bigint", "nullable": false },
        { "name": "lastUsedAt", "type": "bigint" }
      ]
    }
  ]
}
